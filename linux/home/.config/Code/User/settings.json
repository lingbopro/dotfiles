  "importCost.smallPackageLightColor": "#6ca5c1",
  // "inlineFold.regex": "(<svg(\\s*.*[\\n].*[\\n].*?\\s*)<\\/svg>|<path(\\s*.*?\\s*)<\\/path>|data:(\\s*.*?\\s*);[a-zA-z0-9](\\s*.*.?\\s*)[a-zA-z0-9+=])",
